# KomaShift E2E Testing Configuration Template
# Copy this file to .env and fill in your API credentials.
KOMASHIFT_TEST_API_KEY=your_api_key_here
KOMASHIFT_TEST_BASE_URL=https://api.openai.com/v1
KOMASHIFT_TEST_MODEL=gpt-4o-mini
KOMASHIFT_TEST_PROTOCOL=openai
KOMASHIFT_TEST_LANG=en
KOMASHIFT_TEST_MANGA_DIR=./source-manga-sample-76p
